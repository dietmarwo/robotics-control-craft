+            schema: "robotics-control-craft.result/0.1",
+            version: "0.0.0",
+        };
+        let mut out = Vec::new();
+        detail.write_json(&mut out).unwrap();
+        assert_eq!(
+            String::from_utf8(out).unwrap(),
+            serde_json::to_string(&detail).unwrap()
+        );
+    }
