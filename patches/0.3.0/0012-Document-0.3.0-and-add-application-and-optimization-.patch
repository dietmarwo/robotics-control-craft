diff --git a/examples/python/parameter_sensitivity.py b/examples/python/parameter_sensitivity.py
new file mode 100644
index 0000000..7f40f25
--- /dev/null
+++ b/examples/python/parameter_sensitivity.py
@@ -0,0 +1,53 @@
+"""Parameter sensitivity: which plant and controller settings matter most?
+
+For a fixed PD controller this script perturbs each model parameter by +/-1%
+and reports the central-difference elasticity of the score,
+(dScore / Score) / (dParam / Param), together with the change in tracking error
+and effort. Each perturbed model is prepared once; the same candidate is scored
+on all of them. A second table repeats the analysis for the controller gains
+with `score_matrix` on the nominal model.
+
+Run: python examples/python/parameter_sensitivity.py
+"""
+
+from robotics_control_craft import Prepared, load_example
+
+case = load_example()
+model = case["model"] | {"dt_s": 0.01}
+gains = [8.0, 3.0]
+nominal = Prepared(model).evaluate(gains)
+print(f"nominal score {nominal['score']:.9f} with gains {gains}, dt={model['dt_s']} s")
+print("parameter            value   elasticity   d error/dp     d effort/dp")
+for name in ("mass_kg", "spring_n_per_m", "damping_ns_per_m", "force_limit_n",
+             "initial_x_m", "initial_v_m_s"):
+    value = model[name]
+    step = 0.01 * value
+    up = Prepared(model | {name: value + step}).evaluate(gains)
+    down = Prepared(model | {name: value - step}).evaluate(gains)
+    assert up["status"] == down["status"] == "complete", (up, down)
+    slope = (up["score"] - down["score"]) / (2 * step)
+    d_error = (up["metrics"]["integrated_error"] - down["metrics"]["integrated_error"]) / (2 * step)
+    d_effort = (up["metrics"]["integrated_force_squared"]
+                - down["metrics"]["integrated_force_squared"]) / (2 * step)
+    print(f"{name:18s} {value:7.3f} {slope * value / nominal['score']:12.4f}"
+          f" {d_error:14.6f} {d_effort:15.6f}")
+
+interval = model["control"]["interval_s"]
+for scale in (0.5, 1.0, 2.0):
+    control = {"kind": "pd", "interval_s": interval * scale}
+    row = Prepared(model | {"control": control}).evaluate(gains)
+    print(f"controller interval {control['interval_s']:.3f} s: score {row['score']:.6f},"
+          f" peak force {row['metrics']['max_abs_force_n']:.3f} N")
+
+prepared = Prepared(model)
+rows = []
+for i in range(2):
+    for sign in (1, -1):
+        g = list(gains)
+        g[i] *= 1 + sign * 0.01
+        rows.append(g)
+scores, statuses, _ = prepared.score_matrix(rows)
+assert set(statuses) == {"complete"}
+for i, name in enumerate(("kp", "kd")):
+    slope = (scores[2 * i] - scores[2 * i + 1]) / (0.02 * gains[i])
+    print(f"gain {name}: elasticity {slope * gains[i] / nominal['score']:.4f}")
diff --git a/examples/python/pd_gain_study.py b/examples/python/pd_gain_study.py
new file mode 100644
index 0000000..c665ada
--- /dev/null
+++ b/examples/python/pd_gain_study.py
@@ -0,0 +1,68 @@
+"""PD gain study: which gains settle the oscillator with acceptable effort?
+
+The packaged example starts the mass at 1 m with 0.2 m/s and asks a sampled
+PD controller (0.1 s sample interval, 3 N saturation) to bring it to rest at
+the origin within 2.05 s. This script scores a 21 x 17 gain grid in one native
+call with `score_matrix`, then fetches full metrics for the same grid with one
+`batch` call to show the trade-off between tracking error and actuator effort.
+Finally it replays the best gains at half the integration step to check that
+the ranking is not a discretization artifact.
+
+Run: python examples/python/pd_gain_study.py
+"""
+
+import numpy as np
+
+from robotics_control_craft import Prepared, load_example
+
+case = load_example()
+model = case["model"]
+prepared = Prepared(model)
+print("model sha256:", prepared.model_sha256)
+
+kp = np.linspace(0.0, 20.0, 21)
+kd = np.linspace(0.0, 8.0, 17)
+grid = np.array([[p, d] for p in kp for d in kd])
+scores, statuses, steps = prepared.score_matrix(grid)
+scores = np.asarray(scores)
+print(f"grid rows: {len(grid)}, statuses: { {s: statuses.count(s) for s in sorted(set(statuses))} }")
+print(f"steps per rollout: {sorted(set(steps))}")
+
+order = np.argsort(scores)
+print("\nfive best gain pairs by score")
+print("   kp     kd     score")
+for i in order[:5]:
+    print(f"{grid[i, 0]:5.1f}  {grid[i, 1]:5.2f}  {scores[i]:.6f}")
+baseline = int(np.flatnonzero((grid == case["parameters"]).all(axis=1))[0])
+print(f"packaged gains {case['parameters']}: score {scores[baseline]:.6f}")
+
+# Full records carry the score terms; one batch call returns them for all rows.
+candidates = [{"id": f"kp{p:g}-kd{d:g}", "parameters": [p, d]} for p, d in grid]
+records = prepared.batch(candidates)["records"]
+error = np.array([r["metrics"]["integrated_error"] for r in records])
+effort = np.array([r["metrics"]["integrated_force_squared"] for r in records])
+assert all(r["score"] == s for r, s in zip(records, scores))
+
+# Pareto front: no other gain pair has both lower tracking error and lower effort.
+front = [
+    i for i in range(len(grid))
+    if not np.any((error < error[i]) & (effort < effort[i]))
+]
+front.sort(key=lambda i: effort[i])
+print(f"\nPareto front of integrated error versus effort: {len(front)} gain pairs")
+print("   kp     kd   error(m^2 s)  effort(N^2 s)  peak |x| (m)")
+for i in front[:: max(1, len(front) // 8)]:
+    m = records[i]["metrics"]
+    print(f"{grid[i, 0]:5.1f}  {grid[i, 1]:5.2f}  {error[i]:12.6f}  {effort[i]:13.6f}"
+          f"  {m['max_abs_position_m']:.6f}")
+
+# Refined-step replay: halve dt and keep the controller interval fixed.
+best = grid[order[0]].tolist()
+fine = Prepared(model | {"dt_s": model["dt_s"] / 2})
+coarse_row = prepared.evaluate(best)
+fine_row = fine.evaluate(best)
+print(f"\nbest gains {best}")
+print(f"score at dt={model['dt_s']}: {coarse_row['score']:.9f} ({coarse_row['steps']} steps)")
+print(f"score at dt={model['dt_s'] / 2}: {fine_row['score']:.9f} ({fine_row['steps']} steps)")
+fine_scores = np.asarray(fine.score_matrix(grid[order[:5]])[0])
+print("top-five ranking at half step:", np.argsort(fine_scores).tolist())
diff --git a/examples/python/scenario_robustness.py b/examples/python/scenario_robustness.py
new file mode 100644
index 0000000..017f747
--- /dev/null
+++ b/examples/python/scenario_robustness.py
@@ -0,0 +1,64 @@
+"""Scenario robustness: does a tuned controller survive plant uncertainty?
+
+A controller tuned on the nominal plant may degrade when the payload mass or
+the damping differ. This script samples 40 seeded scenarios (mass within
++/-20%, damping between 0.25 and 0.65 N s/m), prepares each scenario once and
+scores four gain pairs per scenario with one `score_matrix` call. It reports
+the mean, worst case and spread of the score, and the number of failed
+rollouts. A second study moves the target close to the position limit, where
+aggressive gains overshoot and become infeasible.
+
+Run: python examples/python/scenario_robustness.py
+"""
+
+import random
+
+import numpy as np
+
+from robotics_control_craft import Prepared, load_example
+
+case = load_example()
+nominal = case["model"]
+controllers = {
+    "zero gains": [0.0, 0.0],
+    "packaged": case["parameters"],
+    "nominal grid best": [16.0, 5.5],
+    "soft": [2.0, 1.0],
+}
+rows = list(controllers.values())
+
+rng = random.Random(2026)
+scenarios = [
+    nominal | {"mass_kg": rng.uniform(0.8, 1.2), "damping_ns_per_m": rng.uniform(0.25, 0.65)}
+    for _ in range(40)
+]
+table = []
+for scenario in scenarios:
+    scores, statuses, _ = Prepared(scenario).score_matrix(rows)
+    table.append([s if st == "complete" else np.nan for s, st in zip(scores, statuses)])
+table = np.array(table)
+
+print(f"{len(scenarios)} scenarios, mass {min(s['mass_kg'] for s in scenarios):.3f}"
+      f"-{max(s['mass_kg'] for s in scenarios):.3f} kg, damping"
+      f" {min(s['damping_ns_per_m'] for s in scenarios):.3f}"
+      f"-{max(s['damping_ns_per_m'] for s in scenarios):.3f} N s/m")
+print("controller           mean      worst     std       failed")
+for j, name in enumerate(controllers):
+    column = table[:, j]
+    ok = column[~np.isnan(column)]
+    print(f"{name:18s} {ok.mean():9.6f} {ok.max():9.6f} {ok.std():9.6f} {np.isnan(column).sum():5d}")
+
+# Stress test: target 1.8 m with the position limit at 2 m, starting at rest.
+stress = nominal | {"target_m": 1.8, "initial_x_m": 0.0, "initial_v_m_s": 0.0}
+gains = np.array([[p, d] for p in (2.0, 8.0, 16.0, 30.0) for d in (0.0, 1.0, 3.0)])
+counts = {}
+for scenario in scenarios[:10]:
+    _, statuses, _ = Prepared(stress | {k: scenario[k] for k in ("mass_kg", "damping_ns_per_m")}).score_matrix(gains)
+    for g, status in zip(map(tuple, gains), statuses):
+        counts.setdefault(g, []).append(status)
+print("\nstress target 1.8 m, limit 2 m: infeasible rollouts out of 10 scenarios")
+print("   kp     kd  infeasible")
+for g, statuses in counts.items():
+    print(f"{g[0]:5.1f}  {g[1]:5.1f}  {statuses.count('infeasible'):10d}")
+first = Prepared(stress).evaluate([30.0, 0.0])
+print("example failure record:", {k: first[k] for k in ("status", "steps", "score", "detail")})
diff --git a/examples/python/scipy_de_tuning.py b/examples/python/scipy_de_tuning.py
new file mode 100644
index 0000000..ef9c372
--- /dev/null
+++ b/examples/python/scipy_de_tuning.py
@@ -0,0 +1,71 @@
+"""SciPy: tune PD gains near the position limit, then polish and replay.
+
+The task moves the mass from rest at 0 m to a target at 1.8 m while the
+position limit is 2 m, over 4 s with a 1 ms integration step. High
+proportional gains with little damping overshoot the limit and the rollout is
+infeasible, so the objective adds a penalty for every non-complete status.
+
+SciPy's differential evolution runs with `vectorized=True`: each generation
+arrives as one (dim, population) array and is scored with a single
+`score_matrix` call on two native workers. Nelder-Mead then polishes the
+winner with a one-row objective. The result is replayed with a trace and at
+half the step size.
+
+Run: python examples/python/scipy_de_tuning.py
+"""
+
+import numpy as np
+from scipy.optimize import differential_evolution, minimize
+
+from robotics_control_craft import Prepared, load_example
+
+model = load_example()["model"] | {
+    "dt_s": 0.001, "horizon_s": 4.0, "target_m": 1.8, "initial_x_m": 0.0, "initial_v_m_s": 0.0,
+}
+prepared = Prepared(model)
+PENALTY = 10.0
+calls = {"native": 0, "rows": 0, "failed": 0}
+
+
+def population_objective(x):
+    """x has shape (2, S); return S penalized scores."""
+    scores, statuses, _ = prepared.score_matrix(x.T, workers=2)
+    calls["native"] += 1
+    calls["rows"] += len(statuses)
+    scores = np.asarray(scores)
+    failed = np.array([s != "complete" for s in statuses])
+    calls["failed"] += int(failed.sum())
+    scores[failed] = PENALTY
+    return scores
+
+
+bounds = [(0.0, 100.0), (0.0, 30.0)]
+result = differential_evolution(
+    population_objective, bounds, seed=7, popsize=16, maxiter=60, tol=1e-10,
+    vectorized=True, updating="deferred", polish=False,
+)
+print(f"DE: best gains {np.round(result.x, 6).tolist()}, score {result.fun:.9f}")
+print(f"DE: {calls['rows']} rows scored in {calls['native']} native calls,"
+      f" {calls['failed']} failed rollouts penalized")
+
+
+def one(x):
+    return population_objective(np.asarray(x)[:, None])[0]
+
+
+polished = minimize(one, result.x, method="Nelder-Mead", bounds=bounds,
+                    options={"xatol": 1e-8, "fatol": 1e-12, "maxiter": 400})
+print(f"Nelder-Mead: gains {np.round(polished.x, 6).tolist()}, score {polished.fun:.9f},"
+      f" {polished.nfev} evaluations")
+
+best = polished.x.tolist() if polished.fun <= result.fun else result.x.tolist()
+replay = prepared.evaluate(best, trace=False)
+m = replay["metrics"]
+print(f"replay: status {replay['status']}, steps {replay['steps']},"
+      f" peak position {m['max_abs_position_m']:.6f} m (limit {model['position_limit_m']} m)")
+print(f"        terminal x {m['terminal_position_m']:.6f} m, v {m['terminal_velocity_m_s']:.6f} m/s")
+fine = Prepared(model | {"dt_s": model["dt_s"] / 2}).evaluate(best)
+print(f"half-step replay score {fine['score']:.9f} (difference {fine['score'] - replay['score']:.2e})")
+reduced = Prepared(model | {"horizon_s": 1.0}).evaluate(best, trace=True)
+print(f"traced first second: {len(reduced['metrics']['trace'])} rows,"
+      f" last row {np.round(reduced['metrics']['trace'][-1], 6).tolist()}")
